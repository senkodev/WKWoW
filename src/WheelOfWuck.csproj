<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\LocalPaths.props" Condition="Exists('..\LocalPaths.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>WheelOfWuck</AssemblyName>
    <RootNamespace>WheelOfWuck</RootNamespace>
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);MSB3277;CS1701;CS1702</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\White Knuckle</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(AppData)\r2modmanPlus-local\WhiteKnuckle\profiles\1\BepInEx</BepInExDir>
    <ManagedDir>$(GameDir)\White Knuckle_Data\Managed</ManagedDir>
    <DeployDir Condition="'$(DeployDir)' == ''">$(BepInExDir)\plugins\senkodev-WheelOfWuck</DeployDir>
    <Deploy Condition="'$(Deploy)' == ''">true</Deploy>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <GameAssembly Include="$(ManagedDir)\*.dll"
                  Exclude="$(ManagedDir)\System*.dll;$(ManagedDir)\mscorlib.dll;$(ManagedDir)\netstandard.dll;$(ManagedDir)\Mono.*.dll;$(ManagedDir)\Microsoft.*.dll" />
    <Reference Include="@(GameAssembly)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wheels.json" LogicalName="wheels.json" />
  </ItemGroup>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DeployDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <ItemGroup>
      <PackageFile Include="..\package\*;..\README.md;..\CHANGELOG.md" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFile)" DestinationFolder="$(DeployDir)" />
  </Target>

</Project>
